{
  "name": "silverbullet-static-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite preview --host 0.0.0.0",
    "build": "bun ./node_modules/typescript/bin/tsc --noEmit && bun scripts/notices.ts && bun ./node_modules/vite/bin/vite.js build && bun scripts/generate.tsx && bun scripts/verify-dist.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "bun test",
    "check": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "verify:dist": "bun scripts/verify-dist.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "highlight.js": "^11.11.1",
    "sanitize-html": "^2.17.0",
    "yaml": "^2.8.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "bun": "1.4.4",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
